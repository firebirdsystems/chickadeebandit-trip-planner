{
  "id": "trip-planner",
  "name": "Trip Planner",
  "version": "1.0.3",
  "description": "Collaborative family vacation planning — itinerary by day, per-person packing lists, shared notes, and booking confirmations in one place.",
  "entrypoint": "index.html",
  "runtime": "static",
  "category": "general",
  "tags": ["travel", "planning", "itinerary", "vacation"],
  "contexts": ["household", "shared_space"],
  "data_access": {
    "reads": ["family.members"],
    "writes": ["family.documents", "app.grocery.pending_items"]
  },
  "exports": ["calendar_events"],
  "permissions": {
    "default_audience": "everyone",
    "requires_approval": false
  },
  "storage": "db",
  "db_encryption": "off",
  "db_plaintext_columns": ["start_date", "end_date", "item_date"],
  "glance": {
    "source": {
      "kind": "sql",
      "query": "SELECT title AS title, start_date AS at FROM app_trip_planner__trips WHERE end_date >= :today AND status <> 'cancelled' ORDER BY start_date LIMIT 3"
    },
    "display": {
      "template": "list",
      "title": "title",
      "when": "at"
    }
  },
  "publishes": [
    "trip.created"
  ],
  "publish_acls": {
    "trip.created": { "require_role": "adult" }
  },
  "automation_actions": {
    "create_trip": {
      "title": "Start a trip",
      "description": "Open a trip when another app's event fires - a booking confirmed, an occasion coming up, a calendar block someone marked as travel. The dates come from the trigger payload.",
      "params": {
        "created_by": { "type": "member", "label": "Planned by", "required": true },
        "title": { "type": "text", "label": "Trip name", "required": true },
        "start_date": { "type": "text", "label": "Start date (YYYY-MM-DD)", "required": true },
        "end_date": { "type": "text", "label": "End date (YYYY-MM-DD)", "required": true },
        "destination": { "type": "text", "label": "Where", "default": "" }
      },
      "dedupe": { "table": "trips", "column": "source_event_id" },
      "steps": [
        {
          "op": "insert",
          "table": "trips",
          "values": {
            "id": "$uuid",
            "title": ":title",
            "destination": ":destination",
            "start_date": ":start_date",
            "end_date": ":end_date",
            "created_by": ":created_by",
            "created_at": "$now",
            "source_event_id": "$event_id"
          }
        }
      ]
    }
  },
  "row_policies": {
    "trips": { "kind": "adult_writable" },
    "trip_members": { "kind": "adult_writable" },
    "itinerary_items": { "kind": "adult_writable" },
    "packing_items": {
      "kind": "owner_only",
      "member_column": "member_id"
    },
    "shared_packing_items": {
      "kind": "adult_writable"
    }
  },
  "store_acls": {
    "calendar_events": {
      "write": { "require_role": "adult" }
    }
  },
  "member_references": {
    "trips": { "column": "created_by", "on_removed": "keep" },
    "itinerary_items": { "column": "created_by", "on_removed": "keep" },
    "trip_members": { "column": "member_id", "on_removed": "delete" },
    "packing_items": [
      { "column": "member_id", "on_removed": "delete" },
      { "column": "checked_by", "on_removed": "keep" }
    ],
    "shared_packing_items": { "column": "checked_by", "on_removed": "keep" }
  },
  "document_acls": {
    "write": { "require_role": "adult" }
  },
  "file_acls": {
    "write": { "require_role": "adult" },
    "read": "document_acl"
  },
  "nav": { "label": "Trips" },
  "agenda": [
    {
      "kind": "event",
      "label": "Trip",
      "source": {
        "kind": "sql",
        "query": "SELECT id AS id, title AS title, NULLIF(destination, '') AS subtitle, :today AS when_at FROM app_trip_planner__trips WHERE start_date <= :today AND end_date >= :today AND status != 'cancelled' LIMIT 5"
      }
    },
    {
      "kind": "event",
      "label": "Itinerary",
      "source": {
        "kind": "sql",
        "query": "SELECT i.id AS id, i.title AS title, COALESCE(NULLIF(i.description, ''), t.destination) AS subtitle, CASE WHEN i.time IS NULL OR i.time = '' THEN i.item_date ELSE i.item_date || 'T' || i.time END AS when_at FROM app_trip_planner__itinerary_items i JOIN app_trip_planner__trips t ON t.id = i.trip_id AND t.status != 'cancelled' WHERE i.item_date = :today ORDER BY i.sort_order LIMIT 20"
      }
    }
  ],
  "icon": "✈️",
  "resource_limits": {
    "max_db_bytes": 52428800,
    "max_files_bytes": 524288000,
    "max_docs_bytes": 524288000
  },
  "ai_access": {
    "allowed": true,
    "mode": "read",
    "db_exports": ["upcoming_trips", "all_trips"]
  }
}
