{
  "id": "trip-planner",
  "name": "Trip Planner",
  "version": "1.0.2",
  "description": "Collaborative family vacation planning — itinerary by day, per-person packing lists, shared notes, and booking confirmations in one place.",
  "entrypoint": "index.html",
  "runtime": "static",
  "category": "general",
  "tags": ["travel", "planning", "itinerary", "vacation"],
  "contexts": ["household", "shared_space"],
  "data_access": {
    "reads": ["family.members"],
    "writes": ["family.documents", "app.grocery.pending_items"]
  },
  "exports": ["calendar_events"],
  "permissions": {
    "default_audience": "everyone",
    "requires_approval": false
  },
  "storage": "db",
  "db_encryption": "off",
  "db_plaintext_columns": ["start_date", "end_date", "item_date"],
  "row_policies": {
    "trips": { "kind": "adult_writable" },
    "trip_members": { "kind": "adult_writable" },
    "itinerary_items": { "kind": "adult_writable" },
    "packing_items": {
      "kind": "owner_only",
      "member_column": "member_id"
    },
    "shared_packing_items": {
      "kind": "adult_writable"
    }
  },
  "store_acls": {
    "calendar_events": {
      "write": { "require_role": "adult" }
    }
  },
  "member_references": {
    "trips": { "column": "created_by", "on_removed": "keep" },
    "itinerary_items": { "column": "created_by", "on_removed": "keep" },
    "trip_members": { "column": "member_id", "on_removed": "delete" },
    "packing_items": [
      { "column": "member_id", "on_removed": "delete" },
      { "column": "checked_by", "on_removed": "keep" }
    ],
    "shared_packing_items": { "column": "checked_by", "on_removed": "keep" }
  },
  "document_acls": {
    "write": { "require_role": "adult" }
  },
  "file_acls": {
    "write": { "require_role": "adult" },
    "read": "document_acl"
  },
  "nav": { "label": "Trips" },
  "icon": "✈️",
  "resource_limits": {
    "max_db_bytes": 52428800,
    "max_files_bytes": 524288000,
    "max_docs_bytes": 524288000
  },
  "ai_access": {
    "allowed": true,
    "mode": "read",
    "db_exports": ["upcoming_trips", "all_trips"]
  }
}
